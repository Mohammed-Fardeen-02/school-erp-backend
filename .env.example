# Application Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME="School ERP Backend"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_erp_dev?schema=public"

# Authentication & Security
JWT_ACCESS_SECRET="replace-with-a-secure-random-secret-key-min-32-chars"
JWT_REFRESH_SECRET="replace-with-a-secure-random-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
BCRYPT_SALT_ROUNDS=12

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Redis & Background Workers (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
