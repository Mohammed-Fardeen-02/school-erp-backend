# ==========================================
# School ERP Backend Environment Variables Template
# ==========================================

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME="School ERP Backend"

# Database Configuration (PostgreSQL Multi-Schema)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example: postgresql://postgres:YOUR_PASSWORD@localhost:5432/due_erp?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/due_erp?schema=public"

# Redis Configuration (BullMQ & Cache)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Super Admin Bootstrap (Optional)
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# Authentication & JWT Secrets (Min 32 characters)
JWT_ACCESS_SECRET="default-development-jwt-access-secret-32-characters-min"
JWT_REFRESH_SECRET="default-development-jwt-refresh-secret-32-characters-min"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
BCRYPT_SALT_ROUNDS=12

# CORS & Rate Limiting
CORS_ORIGIN="*"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
