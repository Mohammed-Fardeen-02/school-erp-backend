// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "organization", "platform", "audit"]
}

// ==========================================
// SCHEMA: auth
// ==========================================

enum UserType {
  PLATFORM // Platform Super Admin / Global Operator
  TENANT   // Institutional Member (scoped through OrganizationMembership)

  @@schema("auth")
}

/// Global User Identity (Unique per email across the entire platform)
model User {
  id                   String                   @id @default(uuid())
  email                String                   @unique @db.VarChar(150)
  passwordHash         String                   @map("password_hash") @db.VarChar(255)
  firstName            String                   @map("first_name") @db.VarChar(100)
  lastName             String                   @map("last_name") @db.VarChar(100)
  phone                String?                  @db.VarChar(30)
  avatarUrl            String?                  @map("avatar_url") @db.VarChar(500)
  userType             UserType                 @default(TENANT) @map("user_type")
  isActive             Boolean                  @default(true) @map("is_active")
  mustChangePassword   Boolean                  @default(false) @map("must_change_password")

  // Real-Time Access Token Invalidation
  tokenVersion         Int                      @default(1) @map("token_version")

  // Security & Brute-Force Lockout
  failedLogins         Int                      @default(0) @map("failed_logins")
  lockedUntil          DateTime?                @map("locked_until")
  lastLoginAt          DateTime?                @map("last_login_at")
  lastLoginIp          String?                  @map("last_login_ip") @db.VarChar(45)

  // Single-Use Cryptographic Password Reset (SHA-256 hash)
  passwordResetHash    String?                  @map("password_reset_hash") @db.VarChar(255)
  passwordResetExpires DateTime?                @map("password_reset_expires")

  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  sessions             Session[]
  auditLogs            AuditLog[]
  memberships          OrganizationMembership[]
  userRoles            UserRole[]

  @@index([userType])
  @@schema("auth")
  @@map("users")
}

/// Device Session Tracking (Long-lived device/browser session)
model Session {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  familyId      String         @map("family_id") @db.VarChar(100) // Token family for rotation & replay detection
  deviceInfo    String?        @map("device_info") @db.VarChar(255)
  ipAddress     String?        @map("ip_address") @db.VarChar(45)
  userAgent     String?        @map("user_agent") @db.Text
  isRevoked     Boolean        @default(false) @map("is_revoked")
  revokedAt     DateTime?      @map("revoked_at")
  revokedReason String?        @map("revoked_reason") @db.VarChar(100) // "LOGOUT", "REUSE_DETECTED", "PASSWORD_CHANGED"
  expiresAt     DateTime       @map("expires_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([familyId])
  @@index([isRevoked])
  @@schema("auth")
  @@map("sessions")
}

/// Refresh Token History (Strict Family Rotation & Replay Detection)
model RefreshToken {
  id                String    @id @default(uuid())
  sessionId         String    @map("session_id")
  tokenHash         String    @unique @map("token_hash") @db.VarChar(255) // SHA-256 hash of random token
  consumedAt        DateTime? @map("consumed_at")                         // Set when exchanged for a new token
  revokedAt         DateTime? @map("revoked_at")                          // Set on logout or reuse detection
  replacedByTokenId String?   @map("replaced_by_token_id")
  expiresAt         DateTime  @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  session           Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([tokenHash])
  @@schema("auth")
  @@map("refresh_tokens")
}

// ==========================================
// SCHEMA: organization
// ==========================================

enum OrganizationType {
  K12_SCHOOL_CHAIN
  INDEPENDENT_SCHOOL
  COLLEGE_UNIVERSITY
  POLYTECHNIC_INSTITUTE
  VOCATIONAL_CENTER

  @@schema("organization")
}

enum LocationType {
  MAIN_CAMPUS
  BRANCH_CAMPUS
  ADMINISTRATIVE_HQ
  TRAINING_CENTER
  HOSTEL_FACILITY
  SPORTS_COMPLEX

  @@schema("organization")
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  TRIAL
  ARCHIVED

  @@schema("organization")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  TERMINATED

  @@schema("organization")
}

enum MembershipType {
  STAFF
  FACULTY
  STUDENT
  GUARDIAN
  TRUSTEE
  CONSULTANT

  @@schema("organization")
}

/// Coarse Administrative Access Level (Phase 2 RBAC Bridge)
enum OrganizationAccessLevel {
  OWNER  // Institutional Founder / Trust Director (profile, branding, quotas, admins)
  ADMIN  // Principal / Campus Head (campuses, staff memberships, settings view)
  MEMBER // General User (Faculty, Student, Guardian - operational access only)

  @@schema("organization")
}

/// Canonical Educational Business Modules
enum ModuleId {
  ACADEMICS
  STUDENTS
  ATTENDANCE
  FEES
  STAFF
  EXAMS
  FRONT_OFFICE
  TIMETABLE
  TRANSPORT
  LIBRARY
  HOSTEL
  SETTINGS

  @@schema("organization")
}

/// Organization Master (SaaS Tenant Root)
model Organization {
  id               String                   @id @default(uuid())
  code             String                   @unique @db.VarChar(50)
  legalName        String                   @map("legal_name") @db.VarChar(200)
  displayName      String                   @map("display_name") @db.VarChar(150)
  organizationType OrganizationType         @default(K12_SCHOOL_CHAIN) @map("organization_type")
  status           TenantStatus             @map("status")

  // Institutional Contact Details
  email            String                   @db.VarChar(120)
  phone            String                   @db.VarChar(30)
  website          String?                  @db.VarChar(200)
  taxId            String?                  @map("tax_id") @db.VarChar(50)
  registrationNo   String?                  @map("registration_no") @db.VarChar(100)

  // Physical Headquarters Address
  addressLine1     String?                  @map("address_line1") @db.VarChar(255)
  addressLine2     String?                  @map("address_line2") @db.VarChar(255)
  city             String?                  @db.VarChar(100)
  state            String?                  @db.VarChar(100)
  country          String                   @default("IN") @db.VarChar(100)
  postalCode       String?                  @map("postal_code") @db.VarChar(20)

  // Localization Defaults (India-compatible default, globally configurable)
  timezone         String                   @default("Asia/Kolkata") @db.VarChar(50)
  currency         String                   @default("INR") @db.VarChar(10)

  // SaaS Subscription Plan & Quotas
  subscriptionPlan String                   @default("STANDARD") @map("subscription_plan") @db.VarChar(50)
  maxLocations     Int                      @default(5) @map("max_locations")
  maxUsers         Int                      @default(500) @map("max_users")
  maxStudents      Int                      @default(2000) @map("max_students")
  trialEndsAt      DateTime?                @map("trial_ends_at")

  // Institutional Branding
  logoUrl          String?                  @map("logo_url") @db.VarChar(500)
  brandColor       String?                  @map("brand_color") @db.VarChar(20)

  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  // Relationships
  locations        Location[]
  memberships      OrganizationMembership[]
  modules          OrganizationModule[]
  auditLogs        AuditLog[]
  roles            Role[]
  userRoles        UserRole[]

  @@index([status])
  @@index([code])
  @@schema("organization")
  @@map("organizations")
}

/// Location Master (Campuses, Branches, Sites)
model Location {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  code           String       @db.VarChar(50)
  name           String       @db.VarChar(150)
  locationType   LocationType @default(BRANCH_CAMPUS) @map("location_type")
  isMainCampus   Boolean      @default(false) @map("is_main_campus")
  isActive       Boolean      @default(true) @map("is_active")

  // Campus Contact
  email          String?      @db.VarChar(120)
  phone          String?      @db.VarChar(30)
  principalName  String?      @map("principal_name") @db.VarChar(100)

  // Address & Geolocation
  addressLine1   String?      @map("address_line1") @db.VarChar(255)
  addressLine2   String?      @map("address_line2") @db.VarChar(255)
  city           String?      @db.VarChar(100)
  state          String?      @db.VarChar(100)
  country        String       @default("IN") @db.VarChar(100)
  postalCode     String?      @map("postal_code") @db.VarChar(20)
  latitude       Decimal?     @db.Decimal(10, 8)
  longitude      Decimal?     @db.Decimal(11, 8)

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  // Relationships
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles      UserRole[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isActive])
  @@schema("organization")
  @@map("locations")
}

/// Organization Memberships (Many-to-Many Tenant Association)
model OrganizationMembership {
  id             String                  @id @default(uuid())
  userId         String                  @map("user_id")
  organizationId String                  @map("organization_id")
  accessLevel    OrganizationAccessLevel @default(MEMBER) @map("access_level")
  membershipType MembershipType          @default(STAFF) @map("membership_type")
  status         MembershipStatus        @default(ACTIVE)
  jobTitle       String?                 @map("job_title") @db.VarChar(100)
  department     String?                 @db.VarChar(100)
  isPrimary      Boolean                 @default(false) @map("is_primary")
  joinedAt       DateTime                @default(now()) @map("joined_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  // Relationships
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles      UserRole[]

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([accessLevel])
  @@schema("organization")
  @@map("organization_memberships")
}

/// Organization Module Subscriptions & Entitlements
model OrganizationModule {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  moduleId       ModuleId     @map("module_id")
  isEnabled      Boolean      @default(true) @map("is_enabled")
  configuredAt   DateTime     @default(now()) @map("configured_at")

  // Relationships
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleId])
  @@index([organizationId])
  @@schema("organization")
  @@map("organization_modules")
}

enum RoleType {
  SYSTEM_TEMPLATE // Curated immutable platform template (organizationId IS NULL)
  CUSTOM          // Tenant-managed custom role (organizationId IS NOT NULL)

  @@schema("organization")
}

/// Dynamic Roles (Platform System Templates & Tenant Custom Roles)
model Role {
  id             String           @id @default(uuid())
  organizationId String?          @map("organization_id") // NULL for Platform System Templates; UUID for Tenant Custom Roles
  roleCode       String           @map("role_code") @db.VarChar(50)
  roleName       String           @map("role_name") @db.VarChar(100)
  description    String?          @db.Text
  roleType       RoleType         @default(CUSTOM) @map("role_type")
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  // Relationships
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions    RolePermission[]
  userRoles      UserRole[]

  @@index([organizationId])
  @@index([roleCode])
  @@index([roleType])
  @@schema("organization")
  @@map("roles")
}

/// Modular Role-Permission Grant Matrix
model RolePermission {
  id        String         @id @default(uuid())
  roleId    String         @map("role_id")
  nodeId    String         @map("node_id")
  isGranted Boolean        @default(true) @map("is_granted")

  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  // Relationships
  role      Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  node      PermissionNode @relation(fields: [nodeId], references: [id], onDelete: Restrict)

  @@unique([roleId, nodeId])
  @@index([roleId])
  @@index([nodeId])
  @@schema("organization")
  @@map("role_permissions")
}

/// User Role Assignment with Complete Lifecycle Tracking & Historical Preservation
model UserRole {
  id             String                 @id @default(uuid())
  userId         String                 @map("user_id")
  organizationId String                 @map("organization_id")
  roleId         String                 @map("role_id")
  locationId     String?                @map("location_id") // NULL = Org-Wide; UUID = Campus-Scoped
  membershipId   String                 @map("membership_id")
  isActive       Boolean                @default(true) @map("is_active")
  assignedBy     String?                @map("assigned_by")
  assignedAt     DateTime               @default(now()) @map("assigned_at")
  revokedBy      String?                @map("revoked_by")
  revokedAt      DateTime?              @map("revoked_at")
  reason         String?                @db.VarChar(255)
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  // Relationships - All Restrict to preserve historical authorization trail
  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role           Role                   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  location       Location?              @relation(fields: [locationId], references: [id], onDelete: Restrict)
  membership     OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([organizationId])
  @@index([roleId])
  @@index([locationId])
  @@index([membershipId])
  @@index([isActive])
  @@schema("organization")
  @@map("user_roles")
}

// ==========================================
// SCHEMA: platform - Canonical Catalog
// ==========================================

enum NodeType {
  MODULE   // Level 1: Root business domain (e.g., STUDENTS, FEES, ACADEMICS)
  SECTION  // Level 2: Functional grouping (e.g., admissions, fee_structures)
  FEATURE  // Level 3: Actionable resource (e.g., student_profile, invoice)
  ACTION   // Level 4: Explicit capability (e.g., void_invoice, publish_grades)

  @@schema("platform")
}

/// Canonical Hierarchical Permission Tree
model PermissionNode {
  id           String           @id @default(uuid())
  nodeCode     String           @unique @map("node_code") @db.VarChar(100)
  nodeName     String           @map("node_name") @db.VarChar(150)
  nodeType     NodeType         @default(FEATURE) @map("node_type")
  parentId     String?          @map("parent_id")
  nodeLevel    Int              @default(3) @map("node_level")
  displayOrder Int              @default(0) @map("display_order")
  description  String?          @db.Text
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  // Self-referencing tree hierarchy
  parent       PermissionNode?  @relation("NodeHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     PermissionNode[] @relation("NodeHierarchy")

  // Role capability mappings
  rolePermissions RolePermission[]

  @@index([parentId])
  @@index([nodeCode])
  @@index([nodeType])
  @@schema("platform")
  @@map("permission_nodes")
}

/// Transactional Invalidation Outbox for Distributed Redis Cache Sync
model RbacInvalidationOutbox {
  id             String    @id @default(uuid())
  eventType      String    @map("event_type") @db.VarChar(50)
  organizationId String    @map("organization_id")
  userId         String?   @map("user_id")
  processed      Boolean   @default(false)
  processedAt    DateTime? @map("processed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([processed, createdAt])
  @@index([organizationId])
  @@schema("platform")
  @@map("rbac_invalidation_outbox")
}


// ==========================================
// SCHEMA: audit
// ==========================================

/// Immutable Security & Activity Audit Log
model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?       @map("organization_id")
  userId         String?       @map("user_id")
  action         String        @db.VarChar(100) // e.g. "LOGIN_SUCCESS", "LOGIN_FAILED", "REPLAY_DETECTED"
  entity         String        @db.VarChar(100) // e.g. "User", "Session"
  entityId       String?       @map("entity_id")
  previousState  Json?         @map("previous_state") // Strictly sanitized (no secrets)
  newState       Json?         @map("new_state")      // Strictly sanitized (no secrets)
  ipAddress      String?       @map("ip_address") @db.VarChar(45)
  userAgent      String?       @map("user_agent") @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")

  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@schema("audit")
  @@map("audit_logs")
}
